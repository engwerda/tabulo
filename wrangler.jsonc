{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabulo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  // Serve Tabulo only on its own domain (APP_URL), not on workers.dev or preview hostnames.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tabulo.example", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tabulo",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_URL": "http://localhost:5173",
    "FORGEJO_URL": "https://forgejo.example",
    "FORGEJO_CLIENT_ID": "replace-with-your-oauth-client-id",
    "BOARD_STATUS_SCOPE": "Status/",
    "BOARD_COLUMNS": "",
    "BOARD_DONE_DAYS": "14",
    "EPIC_LABEL": "Type/Epic"
  },
  "secrets": {
    "required": ["FORGEJO_CLIENT_SECRET", "SESSION_ENCRYPTION_KEY"]
  }
}
