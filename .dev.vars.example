# Copy to .dev.vars for `npm run dev`. Values here override "vars" in wrangler.jsonc.
APP_URL=http://localhost:5173
FORGEJO_URL=https://forgejo.example
FORGEJO_CLIENT_ID=replace-with-your-oauth-client-id
FORGEJO_CLIENT_SECRET=replace-with-your-oauth-client-secret
# 32 random bytes, base64: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
